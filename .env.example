# Copy to .env — never commit .env

LLM_PROVIDER=deepseek

OPENAI_API_KEY=sk-proj-....
GEMINI_API_KEY=...
DEEPSEEK_API_KEY=sk-...
MOONSHOT_API_KEY=sk-...

DEEPSEEK_MODEL=deepseek-v4-flash
OPENAI_MODEL=gpt-5.6-luna
GEMINI_MODEL=gemini-3.1-flash-lite
KIMI_MODEL=kimi-k2.6

DAILY_BUDGET_USD=2
# Bearer token for /api/admin/* — approvals and the admin panel's read API
# (set the same value as TWIN_ADMIN_TOKEN in ../admin-panel/.env).
ADMIN_TOKEN=
# Visitor questions/answers and feedback text are kept this many days, then
# nulled (numbers stay). 0 = never store text.
TEXT_RETENTION_DAYS=90
# Optional OpenAI admin key (sk-admin-…) so the panel can show billed OpenAI
# spend month-to-date; OpenAI has no balance API. Empty = skipped.
# OPENAI_ADMIN_KEY=

# Postgres (data platform). docker compose sets this itself (service "db");
# set it here only when running the server bare-metal against your own
# Postgres. Empty = no database: everything in-memory, nothing survives a
# restart (fine for tests and quick dev).
# DATABASE_URL=postgresql://twin:twin@localhost:5432/twin

# Semantic search over the knowledge base (needs DATABASE_URL). Chunks are
# embedded into pgvector at startup; only changed chunks are re-embedded.
# Empty = term-overlap search, no embedding calls. Gemini and OpenAI are the
# chat providers with an embeddings endpoint; the matching *_API_KEY above
# is reused, so chat on DeepSeek + embeddings on Gemini works fine.
# EMBEDDING_PROVIDER=gemini
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Sites allowed to embed the chat via widget.js (CSP frame-ancestors).
# FRAME_ANCESTORS='self' https://ruudjuffermans.nl
